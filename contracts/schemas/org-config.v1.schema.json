{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org-config.v1.schema.json",
  "title": "OrgConfig v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["languages", "ocr_engine", "document_types", "departments", "routing_rules"],
  "properties": {
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap_role", "registration_role", "role_permissions"],
      "properties": {
        "bootstrap_role": { "type": "string", "minLength": 1 },
        "registration_role": { "type": "string", "minLength": 1 },
        "role_permissions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "upload_defaults": { "$ref": "upload-metadata.v1.schema.json" },
    "classification": {
      "type": "object", "additionalProperties": false, "required": ["backend"],
      "properties": {
        "backend": { "type": "string", "enum": ["disabled", "tfidf", "llm"] },
        "model_path": { "type": "string", "pattern": "\\S", "description": "Path to a trained JSON artifact, relative to the Intelligence process working directory or absolute." },
        "llm_fallback": { "type": "boolean", "description": "Enable an LLM suggestion when the text classifier is unavailable or abstains." },
        "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "if": { "properties": { "backend": { "const": "tfidf" } } },
      "then": { "required": ["model_path"], "properties": { "model_path": {} } }
    },
    "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "ocr_engine": { "type": "string", "minLength": 1 },
    "document_structure": {
      "type": "object", "additionalProperties": false,
      "description": "Optional organization vocabulary for numbered clauses, headings and margin page numbers.",
      "properties": {
        "clause_labels": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
        "heading_labels": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
        "sentence_abbreviations": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
        "page_number_patterns": { "type": "array", "items": { "type": "string", "pattern": "\\S" } }
      }
    },
    "document_types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "departments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "department_aliases": {
      "type": "object",
      "description": "Alternate owner names keyed by a canonical department name.",
      "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } }
    },
    "roles": {
      "type": "object",
      "description": "Canonical role names with optional department and aliases.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "department": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Optional settings and audience profiles for document summaries.",
      "additionalProperties": false,
      "required": ["settings"],
      "properties": {
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_length", "style"],
          "properties": {
            "max_length": {
              "type": "integer", "minimum": 1,
              "description": "Maximum number of Unicode code points across all summary point texts."
            },
            "style": { "type": "string", "enum": ["bullets", "short_paragraph"] }
          }
        },
        "department_profiles": {
          "type": "object",
          "description": "Profiles keyed by canonical department names in departments.",
          "additionalProperties": { "$ref": "summary-profile.v1.schema.json" }
        },
        "role_profiles": {
          "type": "object",
          "description": "Profiles keyed by canonical role names in roles.",
          "additionalProperties": { "$ref": "summary-profile.v1.schema.json" }
        },
        "not_relevant_reasons": {
          "type": "object",
          "description": "Localized reason for an empty summary, keyed by requested language.",
          "additionalProperties": { "type": "string", "pattern": "\\S" }
        }
      }
    },
    "obligation_detection": {
      "type": "object",
      "description": "Candidate detection settings keyed by a language from languages.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cues": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
          "date_patterns": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
          "relative_deadline_patterns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "absolute_deadline_wrappers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "relation_detection": {
      "type": "object",
      "description": "Candidate finding vocabulary and similarity type matches for this organization.",
      "additionalProperties": false,
      "properties": {
        "reference_cues": {
          "type": "object",
          "description": "Literal reference cues keyed by a language from languages.",
          "additionalProperties": { "type": "array", "items": { "type": "string", "pattern": "\\S" } }
        },
        "change_cues": {
          "type": "object",
          "description": "Literal explicit-change phrases keyed by language and relation type.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "supersedes": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
              "amends": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
              "withdraws": { "type": "array", "items": { "type": "string", "pattern": "\\S" } }
            }
          }
        },
        "nonoperative_cues": {
          "type": "object",
          "description": "Phrases that indicate a negated, proposed, or conditional change, keyed by language.",
          "additionalProperties": { "type": "array", "items": { "type": "string", "pattern": "\\S" } }
        },
        "related_document_types": {
          "type": "object",
          "description": "Additional target types eligible for similarity, keyed by source document type.",
          "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "routing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_confidence", "review_role"],
      "properties": {
        "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "review_role": { "type": "string", "pattern": "\\S" }
      }
    },
    "routing_rules": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "conditions", "target", "priority"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
              "priority": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
              "conditions": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "obligation_type": { "type": "string", "enum": ["duty", "prohibition", "reporting", "payment", "review", "other"] },
                  "owner_department": { "type": "string", "pattern": "\\S" },
                  "document_type": { "type": "string", "pattern": "\\S" },
                  "keywords": {
                    "type": "array", "minItems": 1,
                    "items": { "type": "string", "pattern": "\\S" }
                  },
                  "deadline_within_days": { "type": "integer", "minimum": 0, "maximum": 36500 }
                }
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "value"],
                "properties": {
                  "kind": { "type": "string", "enum": ["user", "role_queue", "department_queue"] },
                  "value": { "type": "string", "pattern": "\\S" }
                }
              },
              "escalation_after_days": { "type": "integer", "minimum": 0, "maximum": 36500 }
            }
          },
          {
            "type": "object",
            "description": "Legacy document-to-department metadata, accepted without routing_policy.",
            "additionalProperties": false,
            "required": ["document_type", "department"],
            "properties": {
              "document_type": { "type": "string", "minLength": 1 },
              "department": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    }
  }
}
