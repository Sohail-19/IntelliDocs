{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "detect-relations-request.v1.schema.json",
  "title": "DetectRelationsRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["doc_id"],
  "properties": {
    "doc_id": { "type": "string", "minLength": 1 },
    "org_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "description": "Authenticated Core organization; a document in another organization is treated as missing." }
  }
}
