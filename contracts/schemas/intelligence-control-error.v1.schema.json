{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intelligence-control-error.v1.schema.json",
  "title": "IntelligenceControlError",
  "type": "object",
  "required": ["detail"],
  "properties": {
    "detail": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "enum": ["llm_disabled", "llm_quota", "upload_pages"] },
            "message": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
