{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "summary.v1.schema.json",
  "title": "Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["doc_id", "audience", "language", "points", "not_relevant", "relevance_reason", "generated_by", "verifier_version"],
  "properties": {
    "doc_id": { "type": "string", "pattern": "\\S" },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "department": { "anyOf": [{ "type": "string", "pattern": "\\S" }, { "type": "null" }] },
        "role": { "anyOf": [{ "type": "string", "pattern": "\\S" }, { "type": "null" }] }
      },
      "allOf": [
        { "anyOf": [
          { "type": "object", "required": ["department"], "properties": { "department": { "type": "string" } } },
          { "type": "object", "required": ["role"], "properties": { "role": { "type": "string" } } }
        ] }
      ]
    },
    "language": { "type": "string", "minLength": 2, "pattern": "\\S" },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "citations"],
        "properties": {
          "text": { "type": "string", "pattern": "\\S" },
          "obligation_id": { "type": "string", "minLength": 1, "description": "Present on points copied from the supplied obligation snapshot." },
          "due_date": { "type": "string", "format": "date", "description": "Resolved due date for a stored obligation point." },
          "citations": { "type": "array", "minItems": 1, "items": { "$ref": "citation.v1.schema.json" } }
        }
      }
    },
    "not_relevant": { "type": "boolean" },
    "relevance_reason": { "type": "string", "description": "Explanation of the relevance decision, or an empty string when there is no reason." },
    "generated_by": { "type": "string", "pattern": "\\S", "description": "Identifier for the generator that produced the summary." },
    "verifier_version": { "type": "string", "pattern": "\\S" }
  },
  "if": { "required": ["not_relevant"], "properties": { "not_relevant": { "const": true } } },
  "then": {
    "properties": {
      "points": { "type": "array", "maxItems": 0 },
      "relevance_reason": { "type": "string", "pattern": "\\S" }
    }
  }
}
