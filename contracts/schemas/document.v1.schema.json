{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document.v1.schema.json",
  "title": "Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "filename", "mime_type", "source_uri", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "filename": { "type": "string", "minLength": 1 },
    "mime_type": { "type": "string", "minLength": 1 },
    "source_uri": { "type": "string", "minLength": 1 },
    "parent_document_id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "status": { "type": "string", "enum": ["pending", "processing", "ready", "failed"] },
    "pages": {
      "description": "Optional for legacy metadata-only documents. Required within ParseResult.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "language", "blocks"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "language": { "type": "string", "minLength": 2 },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "text", "bbox", "reading_order"],
              "properties": {
                "type": { "type": "string", "enum": ["paragraph", "heading", "table", "list_item", "clause", "header_footer"] },
                "text": { "type": "string" },
                "bbox": {
                  "description": "Page-local coordinates in points, origin at top left: [x0, y0, x1, y1].",
                  "type": "array", "minItems": 4, "maxItems": 4,
                  "items": { "type": "number", "minimum": 0 }
                },
                "reading_order": { "type": "integer", "minimum": 0 },
                "clause_number": { "type": "string", "minLength": 1 },
                "heading_level": { "description": "One-based heading depth, present on headings.", "type": "integer", "minimum": 1 },
                "heading_path": { "description": "Ancestor heading texts, outermost first; excludes the current heading itself.", "type": "array", "items": { "type": "string", "minLength": 1 } },
                "rows": { "description": "Table rows, with each cell represented as text.", "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
              },
              "if": { "properties": { "type": { "const": "table" } }, "required": ["type"] },
              "then": { "required": ["rows"] }
            }
          }
        }
      }
    }
  }
}
