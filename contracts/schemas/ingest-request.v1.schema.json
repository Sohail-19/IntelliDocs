{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ingest-request.v1.schema.json",
  "title": "Ingest request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["file"],
  "properties": {
    "file": { "type": "string", "format": "binary", "description": "Raw file bytes in the multipart file part." },
