{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ingest-request.v1.schema.json",
  "title": "Ingest request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["file"],
  "properties": {
    "file": { "type": "string", "format": "binary", "description": "Raw file bytes in the multipart file part." },
    "org_id": { "type": "string", "minLength": 1 },
    "index": { "type": "boolean", "description": "Trigger indexing after parsing; defaults to false." },
    "department": { "type": "string", "minLength": 1 },
    "doc_type": { "type": "string", "minLength": 1 },
    "doc_date": { "type": "string", "format": "date" }
  }
}
