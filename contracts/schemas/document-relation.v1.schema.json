{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-relation.v1.schema.json",
  "title": "DocumentRelation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "source_doc_id", "target_doc_id", "relation_type", "scope",
    "source_citations", "target_citations", "confidence", "status", "detected_by", "created_at"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "source_doc_id": { "type": "string", "minLength": 1, "description": "ID of the newer document." },
    "target_doc_id": { "type": "string", "minLength": 1, "description": "ID of the older document." },
    "relation_type": {
      "type": "string",
      "enum": ["supersedes", "amends", "withdraws", "conflicts_with", "references"]
    },
    "scope": { "type": "string", "enum": ["whole_document", "clauses"] },
    "source_citations": {
      "type": "array",
      "items": { "$ref": "citation.v1.schema.json" },
      "description": "Evidence spans in the newer document."
    },
    "target_citations": {
      "type": "array",
      "items": { "$ref": "citation.v1.schema.json" },
      "description": "Evidence spans in the older document."
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence_breakdown": {
      "description": "Deterministic evidence contributions that sum to confidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["explicit_reference", "both_quotes_verified", "date_order_consistent", "recognized_cue"],
      "properties": {
        "explicit_reference": { "type": "number", "minimum": 0, "maximum": 1 },
        "both_quotes_verified": { "type": "number", "minimum": 0, "maximum": 1 },
        "date_order_consistent": { "type": "number", "minimum": 0, "maximum": 1 },
        "recognized_cue": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "status": { "type": "string", "enum": ["proposed", "confirmed", "dismissed"] },
    "needs_review": { "type": "boolean", "description": "Human review is needed before the proposal is accepted." },
    "detected_by": { "type": "string", "minLength": 1, "description": "Identifier of the detector that proposed the relation." },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  },
  "if": { "required": ["status"], "properties": { "status": { "const": "confirmed" } } },
  "then": {
    "properties": {
      "source_citations": { "type": "array", "minItems": 1 },
      "target_citations": { "type": "array", "minItems": 1 },
      "needs_review": { "const": false }
    }
  }
}
