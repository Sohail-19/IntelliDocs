{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "obligation.v1.schema.json",
  "title": "Obligation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "action", "owner", "deadline", "confidence", "status"],
  "oneOf": [
    {
      "description": "Legacy v1 obligations remain readable; new producers use the structured branch.",
      "required": ["owner", "deadline", "status", "source"],
      "properties": {
        "owner": { "type": "string" },
        "deadline": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in_progress", "complete", "cancelled"] },
        "source": { "$ref": "citation.v1.schema.json" }
      }
    },
    {
      "required": ["owner", "deadline", "status", "doc_id", "obligation_type", "citations", "extractor_version"],
      "properties": {
        "owner": { "$ref": "obligation-owner.v1.schema.json" },
        "deadline": { "$ref": "obligation-deadline.v1.schema.json" },
        "status": { "type": "string", "enum": ["extracted", "verified", "needs_review", "rejected"] },
        "doc_id": { "type": "string", "minLength": 1 },
        "obligation_type": { "type": "string", "enum": ["duty", "prohibition", "reporting", "payment", "review", "other"] },
        "citations": { "type": "array", "items": { "$ref": "citation.v1.schema.json" } },
        "extractor_version": { "type": "string", "minLength": 1 }
      }
    }
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "doc_id": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "owner": {
      "oneOf": [
        { "type": "string", "minLength": 1, "deprecated": true },
        { "$ref": "obligation-owner.v1.schema.json" }
      ]
    },
    "deadline": {
      "oneOf": [
        { "type": "string", "format": "date-time", "deprecated": true },
        { "$ref": "obligation-deadline.v1.schema.json" }
      ]
    },
    "source": { "$ref": "citation.v1.schema.json", "deprecated": true },
    "condition": { "type": "string", "minLength": 1 },
    "obligation_type": { "type": "string", "enum": ["duty", "prohibition", "reporting", "payment", "review", "other"] },
    "citations": { "type": "array", "items": { "$ref": "citation.v1.schema.json" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence_breakdown": {
      "description": "Evidence contributions on the confidence scale. The six contributions sum to confidence, within floating-point precision. Exact and fuzzy quote contributions are mutually exclusive.",
      "type": "object",
      "additionalProperties": false,
      "required": ["quote_exact", "quote_fuzzy", "owner_resolved", "deadline_resolved", "recognized_cue", "cross_chunk_agreement"],
      "properties": {
        "quote_exact": { "type": "number", "minimum": 0, "maximum": 1 },
        "quote_fuzzy": { "type": "number", "minimum": 0, "maximum": 1 },
        "owner_resolved": { "type": "number", "minimum": 0, "maximum": 1 },
        "deadline_resolved": { "type": "number", "minimum": 0, "maximum": 1 },
        "recognized_cue": { "type": "number", "minimum": 0, "maximum": 1 },
        "cross_chunk_agreement": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "status": { "type": "string", "enum": ["extracted", "verified", "needs_review", "rejected", "open", "in_progress", "complete", "cancelled"] },
    "extractor_version": { "type": "string", "minLength": 1 }
  }
}
