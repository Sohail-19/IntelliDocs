# Copy to .env and replace placeholders locally. Never commit real values.
INTELLIDOCS_ENV=development
# Use different random values for JWT, bootstrap and the private service key.
INTELLIDOCS_INTERNAL_KEY=
DEMO_MODE=false
LLM_ENABLED=true
DEMO_LLM_CALLS_PER_USER_DAY=20
DEMO_LLM_CALLS_GLOBAL_DAY=100
DEMO_UPLOADS_PER_USER_DAY=5
DEMO_UPLOADS_GLOBAL_DAY=30
DEMO_MAX_CONCURRENT_UPLOADS=2
DEMO_RETENTION_DAYS=7
DEMO_SWEEP_INTERVAL_SECONDS=3600
DEMO_SEED_ACCOUNTS_JSON=
CORE_PORT=3000
WEB_PORT=5173
VITE_API_URL=http://localhost:3000
CORE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORE_MAX_JSON_BYTES=32768
CORE_TRUST_PROXY_HOPS=0
INTELLIGENCE_MAX_JSON_BYTES=524288
TASK_SWEEP_INTERVAL_SECONDS=60
AUTH_JWT_SECRET=
AUTH_BOOTSTRAP_TOKEN=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_RATE_LIMIT_PER_MINUTE=15
INTELLIGENCE_PORT=8000
QDRANT_PORT=6333
POSTGRES_PORT=5432
POSTGRES_DB=YOUR_POSTGRES_DB
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
DATABASE_URL=YOUR_DATABASE_URL
INTELLIGENCE_URL=YOUR_INTELLIGENCE_URL
OBJECT_STORAGE_URL=YOUR_OBJECT_STORAGE_URL
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_PROVIDER=fake
LLM_MODEL=test-model
LLM_BASE_URL=YOUR_LLM_BASE_URL
GENERATION_MAX_RETRIES=2
EXTRACTION_BATCH_SIZE=4
EXTRACTION_MAX_CHUNKS_PER_DOCUMENT=20
EXTRACTION_MAX_RETRIES=1
EXTRACTION_FUZZY_THRESHOLD=1.0
EXTRACTION_CONFIDENCE_WEIGHTS='{"quote_exact":0.25,"quote_fuzzy":0.12,"owner_resolved":0.55,"deadline_resolved":0.10,"recognized_cue":0.05,"cross_chunk_agreement":0.05}'
# Empty uses STORAGE_DIR/llm-cache.
LLM_CACHE_DIR=
# 1.0 requires an exact normalized match; lower values enable fuzzy matching.
VERIFICATION_FUZZY_THRESHOLD=1.0
VERIFICATION_SUPPORT_CHECK=false
# Build-time OCR packs (Tesseract codes); runtime selection still comes from org config.
TESSERACT_LANGUAGES=eng,hin
PARSING_EXTRAS=tesseract,formats
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_PAGES=25
STORAGE_DIR=/data/uploads
ORG_CONFIG_DIR=/config/orgs
DEFAULT_ORG_ID=example
EMBEDDING_BACKEND=fake
# Set both flags when building and running the network-offline E5 Docker image.
PROVISION_E5_SMALL=false
EMBEDDING_LIGHTWEIGHT=false
# Optional override of the provisioned E5 directory when the flag is enabled.
EMBEDDING_LIGHTWEIGHT_MODEL=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# E5 document embeddings require "passage: " including the trailing space.
EMBEDDING_DOCUMENT_PROMPT=
EMBEDDING_QUERY_PROMPT=
# auto: native sparse for BGE-M3/fake; BM25 for dense-only models such as E5.
SPARSE_EMBEDDING_BACKEND=auto
BM25_K1=1.2
BM25_B=0.75
BM25_AVG_DOC_LENGTH=400
EMBEDDING_BATCH_SIZE=32
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
CHUNK_TOKEN_COUNT_METHOD=unicode_words
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks_v1
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATE_POOL_SIZE=50
RETRIEVAL_RRF_K=2
RETRIEVAL_DEFAULT_TOP_K=10
RELATION_CANDIDATE_LIMIT=10
RELATION_QUERY_CHUNKS=24
RELATION_CHUNK_HITS=12
RELATION_MIN_SIMILARITY=0
RELATION_MAX_PAIRS=10
RELATION_PAIRS_PER_CANDIDATE=2
RELATION_MAX_RETRIES=1
RERANKER_BACKEND=none
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
