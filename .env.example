# Copy to .env and replace placeholders locally. Never commit real values.
INTELLIDOCS_ENV=development
CORE_PORT=3000
INTELLIGENCE_PORT=8000
QDRANT_PORT=6333
POSTGRES_PORT=5432
POSTGRES_DB=YOUR_POSTGRES_DB
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
DATABASE_URL=YOUR_DATABASE_URL
INTELLIGENCE_URL=YOUR_INTELLIGENCE_URL
OBJECT_STORAGE_URL=YOUR_OBJECT_STORAGE_URL
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_PROVIDER=fake
LLM_MODEL=test-model
LLM_BASE_URL=YOUR_LLM_BASE_URL
# Build-time OCR packs (Tesseract codes); runtime selection still comes from org config.
TESSERACT_LANGUAGES=eng,hin
PARSING_EXTRAS=tesseract,formats
MAX_UPLOAD_BYTES=20971520
STORAGE_DIR=/data/uploads
ORG_CONFIG_DIR=/config/orgs
DEFAULT_ORG_ID=example
EMBEDDING_BACKEND=fake
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# E5 document embeddings require "passage: " including the trailing space.
EMBEDDING_DOCUMENT_PROMPT=
EMBEDDING_QUERY_PROMPT=
# auto: native sparse for BGE-M3/fake; BM25 for dense-only models such as E5.
SPARSE_EMBEDDING_BACKEND=auto
BM25_K1=1.2
BM25_B=0.75
BM25_AVG_DOC_LENGTH=400
EMBEDDING_BATCH_SIZE=32
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
CHUNK_TOKEN_COUNT_METHOD=unicode_words
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=chunks_v1
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATE_POOL_SIZE=50
RETRIEVAL_RRF_K=2
RETRIEVAL_DEFAULT_TOP_K=10
RERANKER_BACKEND=none
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
