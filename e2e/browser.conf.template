upstream demo_core {
    server core:${CORE_PORT};
}

server {
    listen 8443 ssl;
    server_name 127.0.0.1;
    ssl_certificate /run/e2e-tls/cert.pem;
    ssl_certificate_key /run/e2e-tls/key.pem;

    location /api/ {
        proxy_pass http://demo_core;
    }

    location = /v1/upload {
        proxy_pass http://demo_core;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
    }
}
